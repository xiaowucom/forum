<div class="container">
  <!-- Section 1: 个人信息卡片 -->
  <div class="profile-header">
    <% if (user.avatar) { %>
      <img class="profile-avatar-img" src="<%= user.avatar %>" alt="头像" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
      <span class="profile-avatar profile-avatar--fallback" style="display:none"><%= (user.nickname || user.username).charAt(0) %></span>
    <% } else { %>
      <span class="profile-avatar"><%= (user.nickname || user.username).charAt(0) %></span>
    <% } %>
    <div class="profile-info">
      <div class="profile-name-row">
        <div>
          <h1 class="profile-name"><%= user.nickname || user.username %></h1>
          <% if (user.nickname && user.nickname !== user.username) { %>
            <span class="profile-username">@<%= user.username %></span>
          <% } %>
        </div>
        <button class="btn btn-xs btn-ghost" onclick="openEditProfile()">编辑资料</button>
      </div>
      <p class="profile-bio"><%= user.bio || '暂无简介' %></p>
      <p class="profile-meta">注册于 <%= user.created_at.substring(0, 10) %></p>
    </div>
  </div>

  <!-- Section 2: 数据统计 -->
  <div class="profile-stats">
    <div class="stat-item">
      <span class="stat-num"><%= stats.topic_count %></span>
      <span class="stat-label">发帖</span>
    </div>
    <div class="stat-item">
      <span class="stat-num"><%= stats.reply_count %></span>
      <span class="stat-label">回复</span>
    </div>
    <div class="stat-item">
      <span class="stat-num"><%= stats.total_likes %></span>
      <span class="stat-label">获赞</span>
    </div>
  </div>

  <!-- Section 3: 内容入口区 -->
  <div class="profile-section">
    <div class="profile-menu">
      <a href="/profile/topics" class="profile-menu-item">
        <span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
        <span style="flex:1">我的帖子</span>
        <span class="menu-badge"><%= stats.topic_count %> 篇</span>
        <span class="menu-arrow">&#8250;</span>
      </a>
      <a href="/profile/likes" class="profile-menu-item">
        <span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>
        <span style="flex:1">我赞过的内容</span>
        <span class="menu-badge"><%= stats.likes_count %> 条</span>
        <span class="menu-arrow">&#8250;</span>
      </a>
      <div class="profile-menu-item profile-menu-item--disabled">
        <span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></span>
        <span style="flex:1">我的收藏</span>
        <span class="menu-badge menu-badge--muted">暂未开放</span>
        <span class="menu-arrow menu-arrow--muted">&#8250;</span>
      </div>
    </div>
  </div>

  <!-- Section 4: 管理 -->
  <div class="profile-section">
    <div class="profile-menu">
      <% if (user.role === 'admin') { %>
      <a href="/admin" class="profile-menu-item">
        <span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
        <span style="flex:1">管理后台</span>
        <span class="menu-arrow">&#8250;</span>
      </a>
      <% } %>
      <a href="/profile/settings" class="profile-menu-item">
        <span class="menu-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
        <span style="flex:1">账号设置</span>
        <span class="menu-arrow">&#8250;</span>
      </a>
    </div>
  </div>

  <!-- Profile页面注入email用于QQ邮箱头像检测，服务端渲染时传入 -->
  <% var currentEmail = user.email || ''; %>

  <!-- Section 5: 退出登录 -->
  <div class="profile-logout-section">
    <button class="btn btn-block btn-outline btn-logout" onclick="handleLogout()">退出登录</button>
  </div>
</div>

<!-- 编辑资料模态框 -->
<div class="modal-overlay" id="editModal" style="display:none" onclick="if(event.target===this)closeEditProfile()">
  <div class="modal-content" style="max-width:480px">
    <h3 class="modal-title">编辑资料</h3>
    <div class="form-group">
      <label for="editNickname">昵称</label>
      <input type="text" id="editNickname" class="input" placeholder="你的显示名称" value="<%= user.nickname || '' %>" maxlength="20">
    </div>
    <div class="form-group">
      <label>头像</label>
      <div class="avatar-mode-tabs">
        <button class="avatar-mode-tab active" onclick="switchAvatarMode('upload', this)" id="tabUpload">上传图片</button>
        <button class="avatar-mode-tab" onclick="switchAvatarMode('url', this)" id="tabUrl">填写链接</button>
        <button class="avatar-mode-tab" onclick="switchAvatarMode('qq', this)" id="tabQQ">输入QQ号</button>
      </div>

      <!-- Panel: 上传图片 -->
      <div id="avatarPanelUpload" class="avatar-panel">
        <div class="avatar-upload-row">
          <input type="file" id="avatarFile" accept="image/png,image/jpeg,image/gif,image/webp" class="file-input">
          <button class="btn btn-sm" onclick="uploadAvatar()" id="btnUploadAvatar">上传</button>
        </div>
        <div id="avatarUploadStatus" class="avatar-status"></div>
      </div>

      <!-- Panel: 填写链接 -->
      <div id="avatarPanelUrl" class="avatar-panel" style="display:none">
        <input type="text" id="avatarUrl" class="input" placeholder="https://..." value="<%= user.avatar || '' %>" oninput="onUrlInput(this.value)">
      </div>

      <!-- Panel: 输入QQ号 -->
      <div id="avatarPanelQQ" class="avatar-panel" style="display:none">
        <div class="avatar-qq-row">
          <input type="text" id="avatarQQ" class="input" placeholder="输入QQ号（5-11位纯数字）" maxlength="11" oninput="onQQInput(this.value)">
          <button class="btn btn-sm" onclick="fetchQQAvatar()" id="btnFetchQQ">获取头像</button>
        </div>
        <div id="qqEmailHelper" class="avatar-qq-helper" style="display:none">
          <span id="qqEmailHelperText"></span>
          <button class="btn btn-xs" onclick="useQQEmail()" id="btnUseQQEmail">使用QQ邮箱头像</button>
        </div>
        <div id="avatarQQStatus" class="avatar-status"></div>
      </div>

      <!-- 预览区域 -->
      <div id="avatarPreviewContainer" class="avatar-preview-container">
        <div id="avatarPreviewWrap" class="avatar-preview-wrap" style="display:none">
          <img id="avatarPreviewImg" src="" alt="头像预览" onerror="this.parentElement.style.display='none'">
          <button class="avatar-preview-clear" onclick="clearAvatarPreview()" title="清除预览">×</button>
        </div>
        <% if (user.avatar) { %>
        <div id="avatarCurrentWrap" class="avatar-preview-wrap">
          <img id="avatarCurrentImg" src="<%= user.avatar %>" alt="当前头像" onerror="this.parentElement.style.display='none'" style="opacity:.6">
          <span class="avatar-current-tag">当前</span>
        </div>
        <% } %>
      </div>

      <input type="hidden" id="editAvatar" value="<%= user.avatar || '' %>">
    </div>
    <div class="form-group">
      <label for="editBio">简介</label>
      <textarea id="editBio" class="input" rows="3" placeholder="介绍一下自己..." maxlength="200"><%= user.bio || '' %></textarea>
    </div>
    <div id="editError" class="form-error" style="display:none"></div>
    <div class="modal-actions">
      <button class="btn" onclick="closeEditProfile()">取消</button>
      <button class="btn btn-primary" id="saveProfileBtn" onclick="saveProfile()">保存</button>
    </div>
  </div>
</div>

<script>
var avatarMode = 'upload';
var qqEmailExtracted = '<%= currentEmail %>'.match(/^(\d+)@qq\.com$/i);
var extractedQQ = qqEmailExtracted ? qqEmailExtracted[1] : null;

function openEditProfile() {
  document.getElementById('editModal').style.display = 'flex';
  // 挂载后初始化 QQ 邮箱快捷入口
  renderQQHelper();
}
function closeEditProfile() {
  document.getElementById('editModal').style.display = 'none';
}
function handleLogout() {
  showConfirm('确定退出登录？', { title: '退出登录' })
    .then(function(ok) { if (!ok) return;
      fetch('/api/auth/logout', { method: 'POST' }).then(function() { location.href = '/'; });
    });
}

function switchAvatarMode(mode, btn) {
  avatarMode = mode;
  var ids = { upload: 'Upload', url: 'Url', qq: 'QQ' };
  var target = ids[mode];
  ['Upload','Url','QQ'].forEach(function(m) {
    document.getElementById('avatarPanel'+m).style.display = (m === target) ? '' : 'none';
  });
  document.querySelectorAll('.avatar-mode-tab').forEach(function(el) { el.classList.remove('active'); });
  btn.classList.add('active');
}

function onUrlInput(val) {
  if (val.trim()) {
    document.getElementById('editAvatar').value = val.trim();
    showAvatarPreview(val.trim());
  }
}

function onQQInput(val) {
  var qq = val.trim();
  var btn = document.getElementById('btnFetchQQ');
  btn.disabled = !/^\d{5,11}$/.test(qq);
}

function renderQQHelper() {
  var helper = document.getElementById('qqEmailHelper');
  if (extractedQQ) {
    document.getElementById('qqEmailHelperText').textContent = '已绑定QQ邮箱';
    helper.style.display = 'flex';
  } else {
    helper.style.display = 'none';
  }
}

function showAvatarPreview(url) {
  var wrap = document.getElementById('avatarPreviewWrap');
  var img = document.getElementById('avatarPreviewImg');
  img.src = url;
  wrap.style.display = '';
}

function clearAvatarPreview() {
  document.getElementById('avatarPreviewWrap').style.display = 'none';
  document.getElementById('editAvatar').value = '';
}

function uploadAvatar() {
  var fileInput = document.getElementById('avatarFile');
  var file = fileInput.files[0];
  var statusEl = document.getElementById('avatarUploadStatus');
  statusEl.textContent = '';
  if (!file) { statusEl.textContent = '请先选择图片文件'; return; }
  if (file.size > 2*1024*1024) { statusEl.textContent = '文件不能超过 2MB'; return; }

  var formData = new FormData();
  formData.append('avatar', file);

  var btn = document.getElementById('btnUploadAvatar');
  btn.disabled = true;
  btn.textContent = '上传中...';
  statusEl.textContent = '';

  fetch('/api/auth/avatar/upload', { method: 'POST', body: formData })
    .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
    .then(function(result) {
      if (result.ok) {
        document.getElementById('editAvatar').value = result.data.url;
        showAvatarPreview(result.data.url);
        statusEl.textContent = '';
      } else {
        statusEl.textContent = result.data.error || '上传失败';
      }
      btn.disabled = false;
      btn.textContent = '上传';
    });
}

function fetchQQAvatar() {
  var qq = document.getElementById('avatarQQ').value.trim();
  var statusEl = document.getElementById('avatarQQStatus');
  statusEl.textContent = '';
  if (!/^\d{5,11}$/.test(qq)) { statusEl.textContent = 'QQ号格式不正确'; return; }

  var btn = document.getElementById('btnFetchQQ');
  btn.disabled = true;
  btn.textContent = '获取中...';

  fetch('/api/auth/avatar/qq', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ qq: qq }),
  }).then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
    .then(function(result) {
      if (result.ok) {
        document.getElementById('editAvatar').value = result.data.url;
        showAvatarPreview(result.data.url);
      } else {
        statusEl.textContent = result.data.error || '获取失败';
      }
      btn.disabled = false;
      btn.textContent = '获取头像';
    });
}

function useQQEmail() {
  if (!extractedQQ) return;
  document.getElementById('avatarQQ').value = extractedQQ;
  // switch to QQ tab
  switchAvatarMode('qq', document.getElementById('tabQQ'));
  fetchQQAvatar();
}

function saveProfile() {
  var nickname = document.getElementById('editNickname').value.trim();
  var avatar = document.getElementById('editAvatar').value.trim();
  var bio = document.getElementById('editBio').value.trim();
  var btn = document.getElementById('saveProfileBtn');
  var errEl = document.getElementById('editError');
  errEl.style.display = 'none';
  btn.disabled = true;
  btn.textContent = '保存中...';

  fetch('/api/auth/profile', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ nickname: nickname, avatar: avatar, bio: bio }),
  }).then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
    .then(function(result) {
      if (result.ok) {
        showToast('资料已保存', 'success');
        setTimeout(function() { location.reload(); }, 800);
      } else {
        errEl.textContent = result.data.error || '保存失败';
        errEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = '保存';
      }
    });
}
</script>
