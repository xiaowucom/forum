<div class="container">
  <div class="notif-header">
    <div class="section-label">消息</div>
    <button class="btn btn-xs btn-ghost" id="markAllReadBtn" style="display:none">全部已读</button>
  </div>

  <div id="notif-list"></div>
  <div id="notif-loading" class="loading">加载中...</div>
  <div id="notif-empty" class="empty-card" style="display:none">
    <div class="empty-card-icon">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
    </div>
    <p>暂无消息</p>
    <span>还没有收到任何通知</span>
  </div>
  <div id="notif-pager" class="pagination" style="display:none"></div>
</div>

<script>
(function() {
  var page = 1;
  var listEl = document.getElementById('notif-list');
  var loadingEl = document.getElementById('notif-loading');
  var emptyEl = document.getElementById('notif-empty');
  var pagerEl = document.getElementById('notif-pager');
  var markAllBtn = document.getElementById('markAllReadBtn');

  function getTimeGroup(dt) {
    if (!dt) return 'earlier';
    var t = dt.replace(' ', 'T');
    if (t.indexOf('+') === -1 && t.indexOf('Z') === -1) t += '+08:00';
    var d = new Date(t);
    var now = new Date();
    var todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    var yesterdayStart = new Date(todayStart);
    yesterdayStart.setDate(yesterdayStart.getDate() - 1);
    if (d >= todayStart) return 'today';
    if (d >= yesterdayStart) return 'yesterday';
    return 'earlier';
  }

  function formatTime(dt) {
    if (!dt) return '';
    var d = new Date(dt.replace(' ', 'T') + (dt.indexOf('+') === -1 ? '+08:00' : ''));
    if (isNaN(d)) return dt.substring(0, 16);
    var h = String(d.getHours()).padStart(2, '0');
    var m = String(d.getMinutes()).padStart(2, '0');
    return h + ':' + m;
  }

  function escapeHTML(str) {
    var div = document.createElement('div');
    div.textContent = str || '';
    return div.innerHTML;
  }

  function renderItem(n) {
    var isSys = n.type === 'system';
    var unreadCls = n.is_read ? '' : ' notif-unread';
    var typeCls = isSys ? ' notif-msg-type-system' : (n.type === 'like' ? ' notif-msg-type-like' : ' notif-msg-type-reply');
    var cardCls = 'notif-msg-card' + typeCls + (isSys ? ' notif-msg-system' : ' notif-msg-interact') + unreadCls;
    var timeStr = formatTime(n.created_at);

    if (isSys) {
      return '<div class="' + cardCls + '" data-id="' + n.id + '">'
        + '<div class="notif-msg-row" onclick="toggleSystemMsg(event,' + n.id + ')">'
          + '<span class="notif-msg-icon notif-msg-icon--bell">'
            + '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>'
          + '</span>'
          + '<div class="notif-msg-main">'
            + '<div class="notif-msg-title">' + escapeHTML(n.title || '系统消息') + '</div>'
            + '<div class="notif-msg-desc">管理员' + (n.actor_name ? ' ' + escapeHTML(n.actor_nickname || n.actor_name) : '') + '</div>'
          + '</div>'
          + '<span class="notif-msg-time">' + timeStr + '</span>'
          + '<span class="notif-msg-expand" id="expandIcon' + n.id + '">'
            + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>'
          + '</span>'
        + '</div>'
        + '<div class="notif-body" id="notifBody' + n.id + '"></div>'
        + '<button class="notif-delete-btn" onclick="deleteNotif(event,' + n.id + ')" title="删除">'
          + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
        + '</button>'
        + '</div>';
    } else {
      var url = '/topic/' + n.topic_id;
      if (n.type === 'reply' && n.reply_id) url += '#reply-' + n.reply_id;
      var iconHTML = n.type === 'reply'
        ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>'
        : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>';
      return '<a href="' + url + '" class="' + cardCls + '" data-id="' + n.id + '" onclick="markRead(event,' + n.id + ')">'
        + '<div class="notif-msg-row">'
          + '<span class="notif-msg-icon' + (n.type === 'like' ? ' notif-msg-icon--like' : ' notif-msg-icon--reply') + '">' + iconHTML + '</span>'
          + '<div class="notif-msg-main">'
            + '<div class="notif-msg-title"><span class="notif-msg-actor">' + escapeHTML(n.actor_nickname || n.actor_name || '匿名') + '</span> <span class="notif-msg-action">' + (n.type === 'reply' ? '回复了你' : '赞了你') + '</span></div>'
            + '<div class="notif-msg-desc">点击查看详情</div>'
          + '</div>'
          + '<span class="notif-msg-time">' + timeStr + '</span>'
        + '</div>'
        + '<button class="notif-delete-btn" onclick="deleteNotif(event,' + n.id + ')" title="删除">'
          + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
        + '</button>'
        + '</a>';
    }
  }

  function renderGrouped(notifications) {
    if (!notifications.length) return '';
    var groups = { today: [], yesterday: [], earlier: [] };
    for (var i = 0; i < notifications.length; i++) {
      var g = getTimeGroup(notifications[i].created_at);
      groups[g].push(notifications[i]);
    }
    var html = '';
    if (groups.today.length) {
      html += '<div class="time-group-header">今天</div>';
      for (var i = 0; i < groups.today.length; i++) html += renderItem(groups.today[i]);
    }
    if (groups.yesterday.length) {
      html += '<div class="time-group-header">昨天</div>';
      for (var i = 0; i < groups.yesterday.length; i++) html += renderItem(groups.yesterday[i]);
    }
    if (groups.earlier.length) {
      html += '<div class="time-group-header">更早</div>';
      for (var i = 0; i < groups.earlier.length; i++) html += renderItem(groups.earlier[i]);
    }
    return html;
  }

  function load(pageNum) {
    if (typeof pageNum === 'undefined') pageNum = page;

    loadingEl.style.display = 'block';
    listEl.innerHTML = '';
    emptyEl.style.display = 'none';
    pagerEl.style.display = 'none';

    var apiUrl = '/api/notifications?page=' + pageNum;

    fetch(apiUrl)
      .then(function(r) { return r.json(); })
      .then(function(d) {
        loadingEl.style.display = 'none';
        if (d.total === 0) {
          emptyEl.style.display = 'block';
          markAllBtn.style.display = 'none';
          return;
        }
        markAllBtn.style.display = 'inline-flex';
        listEl.innerHTML = renderGrouped(d.notifications);

        for (var i = 0; i < d.notifications.length; i++) {
          var n = d.notifications[i];
          if (n.type === 'system' && n.content) {
            var body = document.getElementById('notifBody' + n.id);
            if (body) body.textContent = n.content;
          }
        }

        if (d.totalPages > 1) {
          var phtml = '';
          for (var i = 1; i <= d.totalPages; i++) {
            phtml += '<button class="page-btn' + (i === pageNum ? ' active' : '') + '" onclick="goPage(' + i + ')">' + i + '</button>';
          }
          pagerEl.innerHTML = phtml;
          pagerEl.style.display = 'flex';
        }

        updateBadge();
      })
      .catch(function() {
        loadingEl.style.display = 'none';
      });
  }

  window.goPage = function(p) {
    page = p;
    load(p);
  };

  window.markRead = function(e, nid) {
    e.preventDefault();
    var target = e.currentTarget;
    var url = target.getAttribute('href');
    fetch('/api/notifications/' + nid + '/read', { method: 'PUT' }).then(function() {
      updateBadge();
      window.location.href = url;
    });
  };

  window.toggleSystemMsg = function(e, nid) {
    e.stopPropagation();
    var body = document.getElementById('notifBody' + nid);
    var icon = document.getElementById('expandIcon' + nid);
    if (!body || !icon) return;
    var isOpen = body.classList.contains('notif-body--open');
    if (isOpen) {
      body.classList.remove('notif-body--open');
      body.style.maxHeight = null;
      icon.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>';
    } else {
      body.classList.add('notif-body--open');
      body.style.maxHeight = body.scrollHeight + 'px';
      icon.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>';
    }
    if (!isOpen) {
      fetch('/api/notifications/' + nid + '/read', { method: 'PUT' }).then(function() { updateBadge(); });
    }
  };

  window.deleteNotif = function(e, nid) {
    e.preventDefault();
    e.stopPropagation();
    showConfirm('确定删除这条通知？', { title: '删除通知' })
      .then(function(ok) { if (!ok) return;
    fetch('/api/notifications/' + nid, { method: 'DELETE' })
      .then(function(r) { return r.json(); })
      .then(function() {
        var card = document.querySelector('[data-id="' + nid + '"]');
        if (card) {
          card.style.opacity = '0';
          card.style.transform = 'translateX(20px)';
          card.style.transition = 'all .25s ease';
          setTimeout(function() {
            load(page);
          }, 250);
        }
        updateBadge();
      });
    });
  };

  window.markAllRead = function() {
    fetch('/api/notifications/read-all', { method: 'PUT' })
      .then(function(r) { return r.json(); })
      .then(function() {
        load(page);
        updateBadge();
      });
  };

  load(1);
})();
</script>
