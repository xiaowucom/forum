<div class="container">
  <a href="/profile/settings" class="back-link" style="display:inline-block;margin-bottom:20px">&#8592; 返回设置</a>
  <h1 class="page-title">修改密码</h1>

  <div class="profile-section">
    <form id="passwordForm" class="form" onsubmit="handlePasswordChange(event)">
      <div class="form-group">
        <label for="currentPassword">当前密码</label>
        <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password" class="input" placeholder="请输入当前密码">
      </div>
      <div class="form-group">
        <label for="newPassword">新密码</label>
        <input type="password" id="newPassword" name="newPassword" required minlength="6" maxlength="32" autocomplete="new-password" class="input" placeholder="6-32 个字符">
      </div>
      <div class="form-group">
        <label for="confirmPassword">确认新密码</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" maxlength="32" autocomplete="new-password" class="input" placeholder="再次输入新密码">
      </div>
      <div id="passwordError" class="form-error" style="display:none"></div>
      <button type="submit" class="btn btn-primary btn-block">修改密码</button>
    </form>
  </div>
</div>

<script>
function handlePasswordChange(e) {
  e.preventDefault();
  var errEl = document.getElementById('passwordError');
  errEl.style.display = 'none';

  var currentPassword = document.getElementById('currentPassword').value;
  var newPassword = document.getElementById('newPassword').value;
  var confirmPassword = document.getElementById('confirmPassword').value;

  if (!currentPassword || !newPassword || !confirmPassword) {
    errEl.textContent = '请填写所有字段';
    errEl.style.display = 'block';
    return;
  }

  if (newPassword.length < 6 || newPassword.length > 32) {
    errEl.textContent = '新密码为 6-32 个字符';
    errEl.style.display = 'block';
    return;
  }

  if (newPassword !== confirmPassword) {
    errEl.textContent = '两次输入的新密码不一致';
    errEl.style.display = 'block';
    return;
  }

  if (currentPassword === newPassword) {
    errEl.textContent = '新密码不能与当前密码相同';
    errEl.style.display = 'block';
    return;
  }

  fetch('/api/auth/password', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ currentPassword: currentPassword, newPassword: newPassword }),
  }).then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
    .then(function(result) {
      if (result.ok) {
        showToast('密码修改成功', 'success');
        setTimeout(function() {
          window.location.href = '/login?kicked=1';
        }, 800);
      } else {
        errEl.textContent = result.data.error || '修改失败';
        errEl.style.display = 'block';
      }
    })
    .catch(function() {
      errEl.textContent = '网络错误，请重试';
      errEl.style.display = 'block';
    });
}
</script>
